{
  "name": "@blockchaincommons/components",
  "version": "1.0.0-beta.2",
  "type": "module",
  "sideEffects": false,
  "description": "A TypeScript implementation of Blockchain Commons cryptographic components. Supports key generation, signing, verification, encryption, and post-quantum cryptography.",
  "license": "BSD-2-Clause-Patent",
  "author": {
    "name": "Blockchain Commons",
    "email": "info@blockchaincommons.com",
    "url": "https://www.blockchaincommons.com"
  },
  "homepage": "https://github.com/BlockchainCommons/bc-components-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockchainCommons/bc-components-ts.git"
  },
  "bugs": {
    "url": "https://github.com/BlockchainCommons/bc-components-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./ssh": {
      "import": {
        "types": "./dist/ssh.d.mts",
        "default": "./dist/ssh.mjs"
      },
      "require": {
        "types": "./dist/ssh.d.cts",
        "default": "./dist/ssh.cjs"
      },
      "default": "./dist/ssh.mjs"
    },
    "./pq": {
      "import": {
        "types": "./dist/pq.d.mts",
        "default": "./dist/pq.mjs"
      },
      "require": {
        "types": "./dist/pq.d.cts",
        "default": "./dist/pq.cjs"
      },
      "default": "./dist/pq.mjs"
    },
    "./kdf": {
      "import": {
        "types": "./dist/kdf.d.mts",
        "default": "./dist/kdf.mjs"
      },
      "require": {
        "types": "./dist/kdf.d.cts",
        "default": "./dist/kdf.cjs"
      },
      "default": "./dist/kdf.mjs"
    },
    "./sskr": {
      "import": {
        "types": "./dist/sskr.d.mts",
        "default": "./dist/sskr.mjs"
      },
      "require": {
        "types": "./dist/sskr.d.cts",
        "default": "./dist/sskr.cjs"
      },
      "default": "./dist/sskr.mjs"
    },
    "./tags": {
      "import": {
        "types": "./dist/tags.d.mts",
        "default": "./dist/tags.mjs"
      },
      "require": {
        "types": "./dist/tags.d.cts",
        "default": "./dist/tags.cjs"
      },
      "default": "./dist/tags.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "size": "size-limit",
    "api:snapshot": "bun scripts/api-snapshot.ts && bun scripts/api-report.ts --local",
    "api:check": "bun scripts/api-snapshot.ts --check && bun scripts/api-report.ts",
    "clean": "rm -rf dist",
    "docs": "typedoc",
    "postinstall": "bun scripts/pin-lint-typescript.ts",
    "prepublishOnly": "npm run build",
    "lint:pkg": "publint && attw --pack . --profile node16",
    "check:deps": "bun scripts/check-deps.ts",
    "test:golden": "vitest run tests/golden-vectors.test.ts",
    "test:differential": "vitest run tests/differential.test.ts",
    "vectors:generate": "bun scripts/generate-vectors.ts",
    "baseline:build": "bun scripts/build-baseline.ts"
  },
  "keywords": [
    "blockchain",
    "commons",
    "cryptography",
    "keys",
    "signatures",
    "encryption",
    "ed25519",
    "secp256k1",
    "post-quantum"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/node": "^26.1.1",
    "@types/pako": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "prettier": "3.9.6",
    "publint": "^0.3.24",
    "size-limit": "^13.1.1",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@blockchaincommons/crypto": "^1.0.0-beta.2",
    "@blockchaincommons/dcbor": "^1.0.0-beta.1",
    "@blockchaincommons/rand": "^1.0.0-beta.2",
    "@blockchaincommons/sskr": "^1.0.0-beta.2",
    "@blockchaincommons/tags": "^1.0.0-beta.2",
    "@blockchaincommons/uniform-resources": "^1.0.0-beta.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@scure/base": "^2.4.0",
    "pako": "^3.0.2"
  }
}
