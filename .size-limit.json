[
  {
    "name": "ESM root entry (import *), minified + gzipped",
    "path": "dist/index.mjs",
    "limit": "93 kB"
  },
  {
    "name": "root entry, Digest + SymmetricKey + EncryptedMessage only (tree-shaken, siblings external)",
    "path": "dist/index.mjs",
    "import": "{ Digest, SymmetricKey, EncryptedMessage }",
    "ignore": [
      "@blockchaincommons/crypto",
      "@blockchaincommons/dcbor",
      "@blockchaincommons/rand",
      "@blockchaincommons/sskr",
      "@blockchaincommons/tags",
      "@blockchaincommons/uniform-resources"
    ],
    "limit": "6 kB"
  },
  {
    "name": "root entry, package's own code (siblings external)",
    "path": "dist/index.mjs",
    "ignore": [
      "@blockchaincommons/crypto",
      "@blockchaincommons/dcbor",
      "@blockchaincommons/rand",
      "@blockchaincommons/sskr",
      "@blockchaincommons/tags",
      "@blockchaincommons/uniform-resources"
    ],
    "limit": "71 kB"
  },
  {
    "name": "ssh subpath, minified + gzipped",
    "path": "dist/ssh.mjs",
    "limit": "33 kB"
  },
  {
    "name": "pq subpath, minified + gzipped",
    "path": "dist/pq.mjs",
    "limit": "51 kB"
  },
  {
    "name": "kdf subpath, minified + gzipped",
    "path": "dist/kdf.mjs",
    "limit": "53 kB"
  },
  {
    "name": "sskr subpath, minified + gzipped",
    "path": "dist/sskr.mjs",
    "limit": "39 kB"
  },
  {
    "name": "ssh-agent-node subpath, minified + gzipped (node: modules external)",
    "path": "dist/ssh-agent-node.mjs",
    "ignore": [
      "node:net",
      "node:process"
    ],
    "limit": "30 kB"
  },
  {
    "name": "tags subpath, package's own code (the package itself and siblings external)",
    "path": "dist/tags.mjs",
    "limit": "2 kB",
    "ignore": [
      "@blockchaincommons/components",
      "@blockchaincommons/crypto",
      "@blockchaincommons/dcbor",
      "@blockchaincommons/rand",
      "@blockchaincommons/sskr",
      "@blockchaincommons/tags",
      "@blockchaincommons/uniform-resources"
    ]
  }
]
